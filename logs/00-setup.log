── 5. 配置接口地址与静态路由 ──────────────────────────────────────────
[udplab-client]$ ip addr add 172.31.10.10/24 dev eth0
[udplab-client]$ ip link set eth0 up
[udplab-client]$ ip route replace default via 172.31.10.1
[udplab-client]$ ip route replace 172.31.11.0/24 via 172.31.10.1
[udplab-client]$ bash -c for n in 172.31.20.0/24 172.31.12.0/24; do
    ip route del "$n" 2>/dev/null && echo "  已清理历史错路由 $n" || true
  done
[udplab-server]$ ip link set eth0 up
[udplab-server]$ bash -c 
  want="172.31.11.1"
  for a in $(ip -4 -o addr show dev eth0 | awk "{print \$4}" | cut -d/ -f1); do
    if [ "$a" != "$want" ]; then
      echo "  移除多余地址 $a（会被 docker raw 表 DROP）"
      ip addr del "$a/24" dev eth0 || true
    fi
  done
  ip -4 -o addr show dev eth0

2: eth0    inet 172.31.11.1/24 brd 172.31.11.255 scope global eth0\       valid_lft forever preferred_lft forever
